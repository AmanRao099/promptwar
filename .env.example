# HavenAI environment. Copy to .env.local and fill in.
# A real LLM provider is REQUIRED — the app has no mock/offline mode and will
# fail to start without at least one provider key. Provider priority:
# GROQ_API_KEY → GEMINI_API_KEY.

# --- Groq (recommended: free key, no credit card) ---
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Model id. Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (Google GenAI) — used only if GROQ_API_KEY is empty ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Auth / accounts ---
# Secret for signing session cookies. Generate: openssl rand -hex 32
AUTH_SECRET=
# SQLite database file (defaults to ./data/haven.db). Use a persistent volume
# in production; serverless ephemeral filesystems will lose data per deploy.
DATABASE_PATH=
