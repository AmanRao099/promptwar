# HavenAI environment. Copy to .env.local and fill in.
# Google AI Studio API key (https://aistudio.google.com/apikey).
# If omitted, route handlers fall back to deterministic mock scripts so the
# app + demo still run offline. Real Gemini calls require this key.
GEMINI_API_KEY=

# Gemini model id. Defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash
