# HavenAI environment. Copy to .env.local and fill in.
# Provider priority: GROQ_API_KEY → GEMINI_API_KEY → deterministic mock.
# With no key set, the app runs fully offline on mock content.

# --- Groq (recommended free option: free key, no credit card) ---
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Model id. Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (Google GenAI) — used only if GROQ_API_KEY is empty ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
